# ---------------------------------------------------------------------------
# MyMoney — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Neon pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/mymoney?sslmode=require&pgbouncer=true"

# Neon direct (non-pooled) connection — used by Prisma Migrate / introspection.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/mymoney?sslmode=require"

# Auth.js — generate with: npx auth secret    (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional. Only needed when deploying behind a custom domain (Auth.js).
# AUTH_URL="https://your-domain.com"
# AUTH_TRUST_HOST="true"

# Optional. Used to build absolute URLs in exported PDF/CSV headers.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
